<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WindrunnerLauncher.App.ViewModels"
             xmlns:views="using:WindrunnerLauncher.App.Views"
             x:Class="WindrunnerLauncher.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WindrunnerLauncher/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://WindrunnerLauncher/Styles/Typography.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#D7A84A</Color>
      <Color x:Key="SystemAccentColorDark1">#C4963C</Color>
      <Color x:Key="SystemAccentColorDark2">#8F6A2D</Color>
      <Color x:Key="SystemAccentColorDark3">#6A4E20</Color>
      <Color x:Key="SystemAccentColorLight1">#E2BC6A</Color>
      <Color x:Key="SystemAccentColorLight2">#F0D49A</Color>
      <Color x:Key="SystemAccentColorLight3">#F7E6C4</Color>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppWindowBrush" Color="#121212" />
          <SolidColorBrush x:Key="AppChromeBrush" Color="#161616" />
          <SolidColorBrush x:Key="AppOverlayBrush" Color="#DF141414" />
          <SolidColorBrush x:Key="AppPanelBrush" Color="#141414" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#9A9A9A" />
          <SolidColorBrush x:Key="AppHeadlineBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="AppWindowBorderBrush" Color="#5C5C5C" />
          <SolidColorBrush x:Key="AppInputBrush" Color="#1C1C1C" />
          <SolidColorBrush x:Key="AppRaisedBrush" Color="#222222" />
          <SolidColorBrush x:Key="AppControlBrush" Color="#1D1D1D" />
          <SolidColorBrush x:Key="AppHoverBrush" Color="#292929" />
          <SolidColorBrush x:Key="AppPressedBrush" Color="#141414" />
          <SolidColorBrush x:Key="AppDialogBrush" Color="#F2121212" />
          <SolidColorBrush x:Key="AppDialogBorderBrush" Color="#626262" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#D97732" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#EB8B43" />
          <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFF8F0" />
          <SolidColorBrush x:Key="AppCloseHoverBrush" Color="#8C3737" />
          <SolidColorBrush x:Key="AppNavIdleBrush" Color="#B4B4B4" />
          <SolidColorBrush x:Key="AppNavHoverBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppSeparatorBrush" Color="#2F2F2F" />
          <SolidColorBrush x:Key="AppThumbBrush" Color="#5A5A5A" />
          <SolidColorBrush x:Key="AppWindowControlBrush" Color="#9A9A9A" />
          <SolidColorBrush x:Key="AppWindowControlHoverBrush" Color="#F4EFE6" />
          <SolidColorBrush x:Key="AppWindowControlHoverFillBrush" Color="#24F4EFE6" />
          <SolidColorBrush x:Key="AppNewsHoverBrush" Color="#1E232323" />
          <LinearGradientBrush x:Key="AppArtFadeBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#08161616" Offset="0" />
            <GradientStop Color="#65161616" Offset="0.68" />
            <GradientStop Color="#EE161616" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppWindowBrush" Color="#F4F4F4" />
          <SolidColorBrush x:Key="AppChromeBrush" Color="#EEEEEE" />
          <SolidColorBrush x:Key="AppOverlayBrush" Color="#F2F4F4F4" />
          <SolidColorBrush x:Key="AppPanelBrush" Color="#F7F7F7" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#242424" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#6B6B6B" />
          <SolidColorBrush x:Key="AppHeadlineBrush" Color="#242424" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#D0D0D0" />
          <SolidColorBrush x:Key="AppWindowBorderBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="AppInputBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppRaisedBrush" Color="#E8E8E8" />
          <SolidColorBrush x:Key="AppControlBrush" Color="#E8E8E8" />
          <SolidColorBrush x:Key="AppHoverBrush" Color="#E0E0E0" />
          <SolidColorBrush x:Key="AppPressedBrush" Color="#D4D4D4" />
          <SolidColorBrush x:Key="AppDialogBrush" Color="#F8F8F8" />
          <SolidColorBrush x:Key="AppDialogBorderBrush" Color="#B8B8B8" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#B85A24" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#D16D31" />
          <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppCloseHoverBrush" Color="#C94D4D" />
          <SolidColorBrush x:Key="AppNavIdleBrush" Color="#6B6B6B" />
          <SolidColorBrush x:Key="AppNavHoverBrush" Color="#242424" />
          <SolidColorBrush x:Key="AppSeparatorBrush" Color="#D4D4D4" />
          <SolidColorBrush x:Key="AppThumbBrush" Color="#B0B0B0" />
          <SolidColorBrush x:Key="AppWindowControlBrush" Color="#6B6B6B" />
          <SolidColorBrush x:Key="AppWindowControlHoverBrush" Color="#242424" />
          <SolidColorBrush x:Key="AppWindowControlHoverFillBrush" Color="#14000000" />
          <SolidColorBrush x:Key="AppNewsHoverBrush" Color="#14242424" />
          <LinearGradientBrush x:Key="AppArtFadeBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#08EEEEEE" Offset="0" />
            <GradientStop Color="#65EEEEEE" Offset="0.68" />
            <GradientStop Color="#EEEEEEEE" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModsViewModel">
      <views:ModsView />
    </DataTemplate>
    <DataTemplate DataType="vm:ServerViewModel">
      <views:ServerView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://WindrunnerLauncher/Styles/Theme.axaml" />
    <StyleInclude Source="avares://WindrunnerLauncher/Styles/LauncherControls.axaml" />
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/icon.png" />
    </Style>
  </Application.Styles>
</Application>
