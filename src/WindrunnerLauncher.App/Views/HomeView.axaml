<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WindrunnerLauncher.App.ViewModels"
             x:Class="WindrunnerLauncher.App.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             ClipToBounds="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding ArtworkColumnWidth}" />
      <ColumnDefinition Width="{Binding NewsColumnWidth}" />
    </Grid.ColumnDefinitions>
    <Grid ClipToBounds="True">
      <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill" />
      <Border Background="{DynamicResource AppArtFadeBrush}" IsHitTestVisible="False" />
      <Border Classes="art-top-fade" />
      <StackPanel VerticalAlignment="Bottom" Margin="42,0,42,38" Spacing="8" MaxWidth="420">
        <TextBlock Text="{Binding Texts[home.destination]}" Classes="eyebrow hero-muted" />
        <TextBlock Text="{Binding RealmName}" Classes="hero-title" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding RealmAddress}" Classes="hero-muted" FontSize="15" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <Border Classes="status-chip" Classes.ready="{Binding ClientChipReady}" Classes.warn="{Binding ClientHasPatchUpdate}">
            <TextBlock Text="{Binding ClientSummary}" />
          </Border>
          <Border Classes="status-chip" Classes.ready="{Binding ServerIsOnline}" Classes.warn="{Binding ServerIsWarning}">
            <TextBlock Text="{Binding ServerSummary}" />
          </Border>
          <Border Classes="status-chip" Classes.warn="{Binding ModsHasWarning}">
            <TextBlock Text="{Binding ModsSummary}" />
          </Border>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border Grid.Column="1" Background="{DynamicResource AppChromeBrush}" BorderThickness="0" Padding="34,28"
            IsVisible="{Binding ShowNews}">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Margin="0,0,0,20">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Texts[home.news]}" Classes="panel-title" />
            <TextBlock Text="{Binding Texts[home.news.sub]}" Classes="muted" FontSize="13" />
          </StackPanel>
          <Button Grid.Column="1" Classes="news-link"
                  Command="{Binding RefreshNewsCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding Texts[home.news.refresh]}">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M 15 3 C 12.031398 3 9.3028202 4.0834384 7.2070312 5.875 A 1.0001 1.0001 0 1 0 8.5058594 7.3945312 C 10.25407 5.9000929 12.516602 5 15 5 C 20.19656 5 24.450989 8.9379267 24.951172 14 L 22 14 L 26 20 L 30 14 L 26.949219 14 C 26.437925 7.8516588 21.277839 3 15 3 z M 4 10 L 0 16 L 3.0507812 16 C 3.562075 22.148341 8.7221607 27 15 27 C 17.968602 27 20.69718 25.916562 22.792969 24.125 A 1.0001 1.0001 0 1 0 21.494141 22.605469 C 19.74593 24.099907 17.483398 25 15 25 C 9.80344 25 5.5490109 21.062074 5.0488281 16 L 8 16 L 4 10 z" />
          </Button>
          <Button Grid.Column="2" Classes="news-link"
                  Content="{Binding Texts[home.news.viewall]}"
                  Click="ViewAllClicked" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding NewsItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NewsItem">
                <Button Classes="news-entry" Click="NewsItemClicked">
                  <Border Classes="news-item">
                    <Grid ColumnDefinitions="92,*" ColumnSpacing="16">
                      <Border Width="92" Height="68" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource AppControlBrush}">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Date}" Classes="eyebrow" />
                        <TextBlock Text="{Binding Headline}" Classes="news-headline" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="13" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
