<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WindrunnerLauncher.App.Controls"
        x:Class="WindrunnerLauncher.App.Views.Dialogs.ChangePasswordDialog"
        Title="Change Password"
        Width="470"
        Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent">
  <Panel>
    <controls:ParchmentPanel Margin="16" ContentPadding="16">
      <StackPanel Spacing="12">
        <TextBlock Text="Change a local realm password" Classes="subheading" />
        <TextBlock Text="The account must already exist. Its GM level is left unchanged."
                   FontSize="12" Classes="muted" />
        <StackPanel>
          <TextBlock Text="USERNAME" Classes="eyebrow" />
          <TextBox x:Name="UsernameBox" MaxLength="16" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="NEW PASSWORD" Classes="eyebrow" />
          <TextBox x:Name="PasswordBox" PasswordChar="●" MaxLength="16" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <controls:LauncherButton Content="Cancel" Click="CancelClicked" />
          <controls:LauncherButton Classes="accent" Content="Change password" Click="SaveClicked" />
        </StackPanel>
      </StackPanel>
    </controls:ParchmentPanel>
  </Panel>
</Window>
