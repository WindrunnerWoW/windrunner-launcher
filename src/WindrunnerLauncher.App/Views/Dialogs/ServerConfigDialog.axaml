<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WindrunnerLauncher.App.ViewModels"
        xmlns:controls="using:WindrunnerLauncher.App.Controls"
        x:Class="WindrunnerLauncher.App.Views.Dialogs.ServerConfigDialog"
        x:DataType="vm:ServerConfigViewModel"
        Title="Server configuration"
        Width="640"
        Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent">
  <Border Margin="18" Classes="realm-dialog-surface">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14" Margin="22,16,22,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Server configuration" Classes="realm-dialog-title" />
          <TextBlock Text="Ports, rates, and world rules. Values are written to the server's config files and re-applied on every start."
                     Classes="realm-dialog-subtitle" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="realm-dialog-close" Content="×"
                Click="CloseClicked" ToolTip.Tip="Close" />
      </Grid>

      <Border Grid.Row="1" Classes="realm-dialog-rule" />

      <ScrollViewer Grid.Row="2">
        <StackPanel Spacing="18">
          <StackPanel Spacing="8">
            <TextBlock Text="PORTS" Classes="realm-field-label" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="MySQL" FontSize="12" />
                <NumericUpDown Value="{Binding MysqlPort}" Minimum="1" Maximum="65535" Increment="1"
                               FormatString="0" ParsingNumberStyle="Integer" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Auth server" FontSize="12" />
                <NumericUpDown Value="{Binding AuthPort}" Minimum="1" Maximum="65535" Increment="1"
                               FormatString="0" ParsingNumberStyle="Integer" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="World server" FontSize="12" />
                <NumericUpDown Value="{Binding WorldPort}" Minimum="1" Maximum="65535" Increment="1"
                               FormatString="0" ParsingNumberStyle="Integer" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Changing a port while the realm is running requires a restart."
                       Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ServerConfigGroupViewModel">
                <StackPanel Spacing="8" Margin="0,0,0,18">
                  <TextBlock Text="{Binding Title}" Classes="realm-field-label" />
                  <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ServerConfigEntryViewModel">
                        <Grid ColumnDefinitions="*,150" ColumnSpacing="12" Margin="0,0,0,6">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="12" />
                            <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                          </StackPanel>
                          <NumericUpDown Grid.Column="1" IsVisible="{Binding IsNumber}"
                                         Value="{Binding Number}"
                                         Minimum="{Binding Min}"
                                         Maximum="{Binding Max}"
                                         Increment="{Binding Step}"
                                         FormatString="{Binding Format}" />
                          <CheckBox Grid.Column="1" IsVisible="{Binding IsToggle}"
                                    IsChecked="{Binding Toggle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <controls:LauncherButton Content="Reset to defaults" Command="{Binding ResetCommand}"
                                 ToolTip.Tip="Drop every override and restore the values the server ships with" />
        <controls:LauncherButton Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" />
        <controls:LauncherButton Grid.Column="3" Classes="realm-save-button" Content="Save configuration"
                                 Command="{Binding SaveCommand}" />
      </Grid>
    </Grid>
  </Border>
</Window>
