<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WindrunnerLauncher.App.ViewModels"
        xmlns:controls="using:WindrunnerLauncher.App.Controls"
        x:Class="WindrunnerLauncher.App.Views.Dialogs.ModsToolsDialog"
        x:DataType="vm:ModsViewModel"
        Title="Client Mods &amp; Tools"
        Width="720"
        Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent">
  <Border Margin="18" Classes="realm-dialog-surface">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" Margin="22,16,22,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Client Mods &amp; Tools" Classes="realm-dialog-title" />
          <TextBlock Text="Manage mod loaders, launch tweaks, and other client-side tools for this realm."
                     Classes="realm-dialog-subtitle" />
        </StackPanel>
        <Button Grid.Column="1" Classes="realm-dialog-close" Content="×"
                Click="CloseClicked" ToolTip.Tip="Close" />
      </Grid>

      <Border Grid.Row="1" Classes="realm-dialog-rule" />

      <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,100,90,90" Margin="0,0,14,0">
          <TextBlock Text="MODS &amp; TOOLS" Classes="eyebrow" />
          <TextBlock Grid.Column="1" Text="KIND" Classes="eyebrow" />
          <TextBlock Grid.Column="2" Text="FILES" Classes="eyebrow" />
          <TextBlock Grid.Column="3" Text="STATE" Classes="eyebrow" />
        </Grid>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModItemViewModel">
                <Border BorderBrush="{DynamicResource AppSeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,14,4">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,100,90,90" ColumnSpacing="10">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Classes="ink" FontSize="15" />
                        <TextBlock Text="{Binding Description}" FontSize="12" Classes="muted" />
                        <TextBlock Text="{Binding AvailabilityLabel}" FontSize="11" Classes="muted" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding KindLabel}"
                                 Classes="eyebrow" VerticalAlignment="Center" />
                      <controls:LauncherButton Grid.Column="2"
                                               Content="{Binding DownloadLabel}"
                                               Command="{Binding DownloadCommand}"
                                               IsVisible="{Binding HasDownloadSource}"
                                               IsEnabled="{Binding CanDownload}"
                                               Classes.accent="{Binding IsDownloadAction}"
                                               Padding="8,4" />
                      <controls:LauncherButton Grid.Column="3"
                                               Content="{Binding ToggleLabel}"
                                               Command="{Binding ToggleCommand}"
                                               IsEnabled="{Binding CanToggle}"
                                               Classes.accent="{Binding IsEnableAction}"
                                               Classes.danger="{Binding IsDisableAction}"
                                               Padding="8,4" />
                    </Grid>
                    <Button Content="VanillaTweaks options"
                            Classes="vanillatweaks-options"
                            IsVisible="{Binding IsVanillaTweaks}"
                            HorizontalAlignment="Left">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <Border Classes="vanillatweaks-flyout">
                            <ScrollViewer MaxHeight="420">
                              <StackPanel Spacing="8">
                                <TextBlock Text="These settings apply to every realm when this mod is enabled."
                                           Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                <ToggleSwitch Content="{Binding Options.Texts[mods.recommended]}"
                                              IsChecked="{Binding Options.UseRecommendedPreset}" />
                                <ToggleSwitch Content="Large address aware" IsChecked="{Binding Options.LargeAddressAware}" />
                                <ToggleSwitch Content="Always auto-loot" IsChecked="{Binding Options.AlwaysAutoLoot}" />
                                <ToggleSwitch Content="Sound in background" IsChecked="{Binding Options.SoundInBackground}" />
                                <ToggleSwitch Content="TBC nameplate range" IsChecked="{Binding Options.NameplateRangeTbc}" />
                                <ToggleSwitch Content="More sound channels" IsChecked="{Binding Options.MoreSoundChannels}" />
                              </StackPanel>
                            </ScrollViewer>
                          </Border>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
