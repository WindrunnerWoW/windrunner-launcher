<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WindrunnerLauncher.App.ViewModels"
        xmlns:controls="using:WindrunnerLauncher.App.Controls"
        x:Class="WindrunnerLauncher.App.Views.Dialogs.NewsPreviewDialog"
        x:DataType="vm:NewsItem"
        Width="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent">
  <Border Margin="18" Classes="realm-dialog-surface">
    <Border CornerRadius="16" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,Auto">
        <Grid Height="260" PointerPressed="DragAreaPressed">
          <Border Background="{DynamicResource AppControlBrush}">
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
          </Border>
          <Border Classes="news-hero-scrim" />
          <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,22" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border x:Name="CategoryChip" Classes="news-category-chip">
                <TextBlock Text="{Binding Category}" />
              </Border>
              <TextBlock x:Name="MetaText" Classes="news-hero-meta" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Headline}" Classes="news-hero-title" />
          </StackPanel>
          <Button Classes="news-hero-close" Click="CloseClicked" ToolTip.Tip="Close"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
            <Path Classes="window-glyph" Stroke="#FFFFFF" Data="M0,0 L10,10 M10,0 L0,10" />
          </Button>
        </Grid>

        <ScrollViewer x:Name="ArticleScroll" Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,24,32,26" Spacing="12">
            <TextBlock x:Name="SummaryText" Text="{Binding Summary}" Classes="news-article-lede" />
            <StackPanel x:Name="ArticleBody" Spacing="12" />
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="news-dialog-footer">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="SourceText" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <controls:LauncherButton x:Name="CloseButton" Classes="ghost news-dialog-button" Click="CloseClicked" />
              <controls:LauncherButton x:Name="ReadMoreButton" Classes="realm-save-button" Click="ReadMoreClicked" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
