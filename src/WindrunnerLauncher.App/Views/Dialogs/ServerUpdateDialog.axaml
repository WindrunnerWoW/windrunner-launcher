<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WindrunnerLauncher.App.Controls"
        x:Class="WindrunnerLauncher.App.Views.Dialogs.ServerUpdateDialog"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent">
  <Panel>
    <Border Classes="dialog-surface" Margin="16" Padding="20">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Classes="update-arrow" VerticalAlignment="Center">
            <Path Data="M 7,1 L 13,7.5 M 7,1 L 1,7.5 M 7,1 L 7,14"
                  Stroke="{DynamicResource SuccessBrush}"
                  StrokeThickness="2.2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="14"
                  Height="15"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="HeadingText" Classes="subheading" />
            <TextBlock x:Name="VersionsText" Classes="muted" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
          <TextBlock x:Name="NotesHeading" Classes="eyebrow" />
          <Border Classes="release-notes">
            <ScrollViewer MaxHeight="260">
              <SelectableTextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12" />
            </ScrollViewer>
          </Border>
        </StackPanel>

        <TextBlock x:Name="RunningText" Grid.Row="2" Classes="warn" FontSize="12" />
        <TextBlock x:Name="BackupText" Grid.Row="3" Classes="muted" FontSize="12" />

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto">
          <controls:LauncherButton x:Name="SkipButton" Click="SkipClicked" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <controls:LauncherButton x:Name="LaterButton" Click="LaterClicked" />
            <controls:LauncherButton x:Name="UpdateButton" Classes="accent" Click="UpdateClicked" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Panel>
</Window>
