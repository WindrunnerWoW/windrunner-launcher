# Defaults. Copy to portable.local.env if you want to change things without
# dirtying this file.

# 10.11 on purpose — dumps and install docs assume older collation defaults.
# 11.8+ will bite you on a fresh import.
MARIADB_VERSION=10.11.11
MARIADB_ZIP_URL=https://archive.mariadb.org/mariadb-10.11.11/winx64-packages/mariadb-10.11.11-winx64.zip

MYSQL_PORT=3307
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_USER=mangos
MYSQL_PASSWORD=mangos

REALM_NAME=Windrunner
REALM_ADDRESS=127.0.0.1
REALM_PORT=3724
WORLD_PORT=8090

# Keep this low until first boot works. Raise later.
MIN_RANDOM_BOTS=20
MAX_RANDOM_BOTS=20

# Server + SQL from GitHub releases (same tag = matching commit).
# Latest is the newest Windrunner release; pin TORTOISE_WOW_RELEASE or override URLs.
TORTOISE_WOW_REPO=WindrunnerWoW/windrunner-wow
TORTOISE_WOW_RELEASE=latest
